# Salin ke .env.local lalu isi.
# Password login dashboard (/admin/login). WAJIB diisi di production.
ADMIN_PASSWORD=ganti-dengan-password-kuat
# String acak panjang untuk menandatangani cookie sesi (min. 32 karakter).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# URL publik website (dipakai sitemap, canonical, OG, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://rezz.studio
# Opsional: lokasi penyimpanan data & upload (default ./data). Arahkan ke volume persisten di VPS/Docker.
DATA_DIR=./data
